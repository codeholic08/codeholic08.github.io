{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maaz-portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://codeholic08.github.io",
    "GEMINI_MODEL": "gemini-3.5-flash"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
